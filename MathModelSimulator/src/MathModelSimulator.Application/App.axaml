<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathModelSimulator.Application.App"
             xmlns:local="using:MathModelSimulator"
             xmlns:application="clr-namespace:MathModelSimulator.Application"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <application:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Assets/Icons.axaml"></StyleInclude>
    </Application.Styles>
</Application>